{
  "app-id": "io.github.catoblepa.PDFCropper",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "pdfcropper",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--env=TESSDATA_PREFIX=/app/share/tessdata"
  ],
  "modules": [
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_UNSTABLE_API_ABI_HEADERS=ON",
        "-DENABLE_BOOST=OFF",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-26.11.0.tar.xz",
          "sha256": "41c32680160addf5a8dd7a830e4869c01e9f6bee1abb91e44fabd1ba9d7828fb",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 3686,
            "url-template": "https://poppler.freedesktop.org/poppler-$version.tar.xz"
          }
        }
      ]
    },
    {
      "name": "libleptonica",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://api.github.com/repos/DanBloomberg/leptonica/tarball/1.87.0",
          "sha256": "bf61d070dd84511d34b84c279fe4c473e62a58b71724476efa1a736171755ebb",
          "x-checker-data": {
            "type": "github",
            "repo": "DanBloomberg/leptonica",
            "tag-pattern": "^([0-9.]+)$",
            "source-archive": "tarball"
          }
        }
      ]
    },
    {
      "name": "tesseract",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-graphics"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://api.github.com/repos/tesseract-ocr/tesseract/tarball/5.5.4",
          "sha256": "01780edb963b0397ad369e9eabb9c3403a259e19ab73b03cd73197cc50c7a001",
          "x-checker-data": {
            "type": "github",
            "repo": "tesseract-ocr/tesseract",
            "tag-pattern": "^([0-9.]+)$",
            "source-archive": "tarball"
          }
        }
      ]
    },
    {
      "name": "tessdata",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p ${FLATPAK_DEST}/share/tessdata",
        "cp -av *.traineddata ${FLATPAK_DEST}/share/tessdata/"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/eng.traineddata",
          "sha256": "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/ita.traineddata",
          "sha256": "b8f89e1e785118dac4d51ae042c029a64edb5c3ee42ef73027a6d412748d8827"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/deu.traineddata",
          "sha256": "19d219bbb6672c869d20a9636c6816a81eb9a71796cb93ebe0cb1530e2cdb22d"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/fra.traineddata",
          "sha256": "ced037562e8c80c13122dece28dd477d399af80911a28791a66a63ac1e3445ca"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/spa.traineddata",
          "sha256": "6f2e04d02774a18f01bed44b1111f2cd7f3ba7ac9dc4373cd3f898a40ea6b464"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/por.traineddata",
          "sha256": "c4932b937207a9514b7514d518b931a99938c02a28a5a5a553f8599ed58b7deb"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/nld.traineddata",
          "sha256": "ced0e5e046a84c908a6aa7accbef9a232c4a5d9a8276691b81c6ee64d02963f6"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/rus.traineddata",
          "sha256": "e16e5e036cce1d9ec2b00063cf8b54472625b9e14d893a169e2b0dedeb4df225"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/pol.traineddata",
          "sha256": "c4476cdbc0e33d898d32345122b7be1cbf85ace15f920f06c7714756e1ef79b2"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/tur.traineddata",
          "sha256": "7393381111e1152420fc4092cb44eef4237580d21b92bf30d7d221aad192c6b7"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/jpn.traineddata",
          "sha256": "1f5de9236d2e85f5fdf4b3c500f2d4926f8d9449f28f5394472d9e8d83b91b4d"
        }
      ]
    },
    {
      "name": "pypdf",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --prefix=${FLATPAK_DEST} --find-links=\"file://${PWD}\" pypdf"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/5b/ef/11ed995bd10a1632f7fea3da38ae8d42bc3ccc5b9969fe04d8620c844408/pypdf-7.1.1-py3-none-any.whl",
          "sha256": "04c5680d4b4cfa04ab505b09393fc949860c34a4dad6565284d11a2f5c3ce8b1",
          "x-checker-data": {
            "type": "pypi",
            "name": "pypdf",
            "packagetype": "bdist_wheel"
          }
        }
      ]
    },
    {
      "name": "pdfcropper",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/catoblepa/PDFCropper.git",
          "tag": "v0.2.0"
        }
      ]
    }
  ]
}
