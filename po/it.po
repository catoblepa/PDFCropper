#: ../src/dialogs.py:242
msgid "Note"
msgstr "Nota"

#: ../src/dialogs.py:244
msgid ""
"width = x1 - x0 and height = bottom - top. The <span "
"font_family='monospace'>(left, top, right, bottom)</span> format matches "
"pdfplumber, PyMuPDF and Camelot; <span font_family='monospace'>x, y, width, "
"height</span> matches pdftotext. Tabula expects <span "
"font_family='monospace'>(top, left, bottom, right)</span>."
msgstr ""
"larghezza = x1 - x0 e altezza = basso - alto. Il formato <span "
"font_family='monospace'>(sinistra, alto, destra, basso)</span> corrisponde a "
"pdfplumber, PyMuPDF e Camelot; <span font_family='monospace'>x, y, "
"larghezza, altezza</span> corrisponde a pdftotext. Tabula si aspetta "
"l'ordine <span font_family='monospace'>(alto, sinistra, basso, destra)</"
"span>."

