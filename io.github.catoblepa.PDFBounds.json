{
  "app-id": "io.github.catoblepa.PDFBounds",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "bounds",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--filesystem=host:ro"
  ],
  "modules": [
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_UNSTABLE_API_ABI_HEADERS=ON",
        "-DENABLE_BOOST=OFF",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-26.08.0.tar.xz",
          "sha256": "dc906e68cea698109706ac6aa3d2c9d4512fcfcac42d90b8afcda486d1b9abd0"
        }
      ]
    },
    {
      "name": "bounds",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
